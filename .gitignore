# ==============================================================================
# KalaSetu Consolidated .gitignore (Root for Backend + Flutter Mobile App)
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors & IDEs
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.atom/
.history/

# ------------------------------------------------------------------------------
# Python Backend (FastAPI / Uvicorn / ML / Testing)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Pytest / Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Jupyter / IPython
.ipynb_checkpoints

# ------------------------------------------------------------------------------
# Flutter / Dart Mobile App (kalasetu_app)
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
**/build/
**/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
migrate_working_dir/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# Android Platform (Flutter)
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/app/build/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/GeneratedPluginRegistrant.java
**/android/app/debug
**/android/app/profile
**/android/app/release
*.apk
*.aab

# ------------------------------------------------------------------------------
# iOS Platform (Flutter)
# ------------------------------------------------------------------------------
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/DerivedData/
*.ipa

# ------------------------------------------------------------------------------
# Miscellaneous & Logs
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*~
